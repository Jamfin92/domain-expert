{
  "name": "psq-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "psq": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && pnpm --filter @psq/web typecheck && pnpm --filter @psq/desktop typecheck",
    "build": "pnpm typecheck && pnpm build:web && pnpm --filter @psq/desktop build",
    "test": "vitest run",
    "selftest": "tsx apps/cli/src/index.ts selftest",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "pnpm -C apps/web exec vite",
    "build:web": "pnpm -C apps/web exec vite build",
    "desktop": "pnpm --filter @psq/desktop start",
    "test:e2e": "pnpm build:web && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@psq/extract": "workspace:*",
    "@psq/graph": "workspace:*",
    "@psq/quiz": "workspace:*",
    "@psq/schema": "workspace:*",
    "@psq/server": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "playwright-core": "^1.62.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
