{
  "name": "psq-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "psq": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "selftest": "tsx apps/cli/src/index.ts selftest",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@psq/schema": "workspace:*",
    "@psq/extract": "workspace:*",
    "@psq/graph": "workspace:*",
    "@psq/quiz": "workspace:*"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
